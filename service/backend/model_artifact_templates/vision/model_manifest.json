{
  "task": "vision",
  "model_name": "pd_prpd_light_cnn",
  "model_version": "0.1.0",
  "framework": "pytorch",
  "entrypoint": "ml.vision.src.service_adapter:load_adapter",
  "checkpoint_path": "checkpoint.pt",
  "preprocessor_path": "preprocessor.json",
  "label_map": {
    "0": "정상",
    "1": "노이즈",
    "2": "표면 방전",
    "3": "코로나 방전",
    "4": "보이드 방전"
  },
  "input_spec": {
    "modality": "prpd_png",
    "schema_version": "1.0",
    "shape": [3, 224, 224],
    "dtype": "float32",
    "notes": "PRPD image artifact path is passed through VisionToolInput.image_path."
  },
  "output_spec": {
    "schema_version": "1.0",
    "required_fields": ["label_id", "confidence", "probabilities", "evidence"],
    "notes": "The backend output is normalized to VisionResult."
  },
  "thresholds": {
    "min_confidence": 0.72,
    "ood_review_score": 0.45
  },
  "runtime": {
    "device": "auto",
    "batch_size": 1
  }
}
